# Copy to .env.local. Never commit real values. Leave all five blank and the site runs as a
# stats site; fill them in to switch markets on (README: Turning markets on).

# Neon Postgres (see Docs/integration-specs/neon-drizzle.md)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=

# Clerk (see Docs/integration-specs/clerk.md)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
