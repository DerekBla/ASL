{
  "name": "starcoins",
  "version": "0.0.0",
  "private": true,
  "description": "Fan-made, play-money prediction market and stats site for the ASL (StarCraft: Brood War)",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats:export": "python scripts/liquipedia/parse_seasons.py --quiet && python scripts/export-stats/export_stats.py data/source data/generated",
    "stats:test": "python -m unittest discover -s scripts/liquipedia/tests -v && python -m unittest discover -s scripts/export-stats/tests -v",
    "stats:fetch": "python scripts/liquipedia/fetch_seasons.py && python scripts/liquipedia/parse_seasons.py --quiet && python scripts/liquipedia/fetch_players.py && python scripts/liquipedia/parse_seasons.py --quiet",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:make-admin": "tsx scripts/db/make-admin.ts",
    "test:ledger-concurrency": "vitest run src/lib/services/ledger/__tests__/concurrency.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.11",
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-query": "5.104.1",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "ws": "8.22.0",
    "zod": "^4.6.5",
    "zustand": "5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
